<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>PS - Admin Field Access</label>
    <description>Admin convenience: read/edit FLS for all DistribuYa custom fields, so admins see every field in Setup/Flow Builder/manual steps. Required fields are omitted (always visible); formula fields are read-only. See LL-021.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Account -->
    <fieldPermissions><field>Account.Credit_Limit__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.Credit_Used__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.Customer_Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.Onboarding_Stage__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.Payment_Terms__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.Segment__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Credit_History__c (Change_Timestamp__c is required -> omitted) -->
    <fieldPermissions><field>Credit_History__c.Account__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Credit_History__c.New_Limit__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Credit_History__c.Previous_Limit__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Credit_History__c.Reason__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Product2 (Product_Family__c is required -> omitted) -->
    <fieldPermissions><field>Product2.Available_Stock__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product2.ERP_Product_ID__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product2.Stock_Last_Sync__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Product_Family__c -->
    <fieldPermissions><field>Product_Family__c.Brand__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Family__c.Image_URL__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Family__c.Long_Description__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Family__c.Product_Category__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Family__c.Product_Manager__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Product_Category__c -->
    <fieldPermissions><field>Product_Category__c.Active__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Category__c.Description__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Category__c.Display_Order__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Product_Category__c.Icon_URL__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Customer_Price__c (Override_Price__c + Account__c are required -> omitted) -->
    <fieldPermissions><field>Customer_Price__c.Effective_Date__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Customer_Price__c.End_Date__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Customer_Price__c.Negotiated_By__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Customer_Price__c.Notes__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Customer_Price__c.Product2__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Price_Tier__c (Min_Quantity__c, Tier_Price__c are required -> omitted) -->
    <fieldPermissions><field>Price_Tier__c.Effective_Date__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Price_Tier__c.End_Date__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Price_Tier__c.Max_Quantity__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Price_Tier__c.Pricebook2__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Price_Tier__c.Product2__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Order (Order_Stage__c is a formula -> read-only) -->
    <fieldPermissions><field>Order.Credit_Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Order.Fulfillment_Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Order.Order_Type__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Order.Payment_Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Order.Order_Stage__c</field><readable>true</readable><editable>false</editable></fieldPermissions>

    <!-- OrderItem (Discount_Amount__c is a formula -> read-only) -->
    <fieldPermissions><field>OrderItem.Applied_Price_Source__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>OrderItem.Base_Price__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>OrderItem.Price_Modifier_Id__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>OrderItem.Discount_Amount__c</field><readable>true</readable><editable>false</editable></fieldPermissions>

    <!-- Stock_Reservation__c (Quantity__c is required -> omitted) -->
    <fieldPermissions><field>Stock_Reservation__c.Expiry_Timestamp__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.OrderItem__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.Product2__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.Released_By__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.Released_Reason__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.Reservation_Reason__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Stock_Reservation__c.Status__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
</PermissionSet>
